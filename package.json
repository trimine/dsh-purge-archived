{
  "name": "dsh-purge-archived",
  "version": "1.1.0",
  "description": "Delete archived DeepSeek Harness conversations from local storage: takes the writer lock, removes log files, then clears the archive mark, workspace membership and projection cache.",
  "icon": "icon.svg",
  "author": "trimine",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/trimine/dsh-purge-archived.git"
  },
  "homepage": "https://github.com/trimine/dsh-purge-archived",
  "bugs": {
    "url": "https://github.com/trimine/dsh-purge-archived/issues"
  },
  "type": "module",
  "scripts": {
    "test": "node --test --test-isolation=none tests/*.test.mjs"
  },
  "engines": {
    "node": "^22.19.0 || >=24.0.0",
    "dsh": ">=0.2.0-rc.2 || >=0.2.1-rc.2"
  },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "path-safety.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "keywords": [
    "deepseek-harness",
    "dsh",
    "cordis",
    "plugin",
    "archive",
    "session",
    "delete",
    "cleanup"
  ],
  "license": "MIT",
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-workspace"
      ]
    },
    "compatibility": {
      "dshReleases": {
        "0.2.1-rc.5": "compatible"
      }
    }
  },
  "publishConfig": {
    "access": "public"
  }
}
